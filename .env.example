# App
APP_NAME=TranslateKH Compatible API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=86400

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20

# HTTP Basic Auth — clients authenticate with these credentials
API_USERNAME=
API_PASSWORD=
# Provider: google | gemini | openrouter | stub
# "google" builds a cascade: Google Translate → Gemini → OpenRouter
# Providers with missing keys are automatically skipped at startup.
TRANSLATION_PROVIDER=google

# Provider credentials — never logged
GOOGLE_TRANSLATE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=